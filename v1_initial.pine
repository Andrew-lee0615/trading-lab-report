//@version=5
strategy("SOXL RSI Reversal Strategy (1H)", overlay=false, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.05)

// ============ INPUTS ============
rsiLength   = input.int(14, "RSI Length")
oversold    = input.int(30, "Oversold Level (Buy Trigger)")
buyMode     = input.string("Cross Back Above (확인 후 진입)", "Buy Trigger Mode",
     options=["Cross Below (즉시 진입)", "Cross Back Above (확인 후 진입)"])

exitTarget  = input.int(50, "1차 청산 목표 RSI")
useRollover = input.bool(true, "모멘텀 롤오버 청산 사용")
rolloverPeak = input.int(55, "롤오버 기준 고점 RSI")

useStop     = input.bool(true, "손절 사용")
stopPct     = input.float(6.0, "손절 %", step=0.5)

useTimeFilter = input.bool(false, "거래시간 필터 사용 (정규장만)")

// ============ RSI ============
rsiVal = ta.rsi(close, rsiLength)

// ============ ENTRY LOGIC ============
crossBelow = ta.crossunder(rsiVal, oversold)
crossBackAbove = ta.crossover(rsiVal, oversold)

buySignal = buyMode == "Cross Below (즉시 진입)" ? crossBelow : crossBackAbove

// 시간 필터 (미국 정규장 9:30-16:00 ET 기준, 필요시 조정)
inSession = true
if useTimeFilter
    inSession := (hour(time, "America/New_York") >= 9 and hour(time, "America/New_York") < 16)

longCondition = buySignal and inSession and strategy.position_size == 0

// ============ EXIT LOGIC (모멘텀 롤오버 추적) ============
var float peakRsiSinceEntry = na

if strategy.position_size > 0
    peakRsiSinceEntry := na(peakRsiSinceEntry) ? rsiVal : math.max(peakRsiSinceEntry, rsiVal)
else
    peakRsiSinceEntry := na

rolloverExit = useRollover and not na(peakRsiSinceEntry) and peakRsiSinceEntry >= rolloverPeak and ta.crossunder(rsiVal, rolloverPeak - 3)
targetExit = ta.crossover(rsiVal, exitTarget)

exitCondition = targetExit or rolloverExit

// ============ ENTRY / EXIT EXECUTION ============
if longCondition
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    if useStop
        stopPrice = strategy.position_avg_price * (1 - stopPct / 100)
        strategy.exit("Stop/Exit", "Long", stop=stopPrice, comment_profit="RSI Exit", when=exitCondition or true)
    if exitCondition
        strategy.close("Long", comment=targetExit ? "RSI Target" : "Rollover")

// ============ PLOTS ============
plot(rsiVal, "RSI", color=color.new(color.blue, 0), linewidth=2)
hline(oversold, "Oversold", color=color.red, linestyle=hline.style_dashed)
hline(exitTarget, "Exit Target", color=color.green, linestyle=hline.style_dashed)
hline(rolloverPeak, "Rollover Peak", color=color.orange, linestyle=hline.style_dotted)
hline(50, "50", color=color.gray, linestyle=hline.style_dotted)

bgcolor(strategy.position_size > 0 ? color.new(color.green, 90) : na)

// ============ ALERTS ============
alertcondition(longCondition, "SOXL RSI Buy", "RSI 매수 신호 발생")
alertcondition(exitCondition, "SOXL RSI Sell", "RSI 매도 신호 발생")
